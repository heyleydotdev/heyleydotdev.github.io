---
import {Font} from 'astro:assets'
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<Font cssVariable='--font-geist-mono' preload />

		<title>heyleydotdev — Software Developer</title>
		<meta
			name="description"
			content="heyleydotdev is a software developer from Sri Lanka working with TypeScript, Go and scalable production systems."
		/>
		<meta property="og:title" content="heyleydotdev — Software Developer" />
		<meta
			property="og:description"
			content="heyleydotdev is a software developer from Sri Lanka working with TypeScript, Go and scalable production systems."
		/>
	</head>
	<body class="h-full font-mono antialiased text-sm bg-zinc-50 text-zinc-950">
		<main class="min-h-full flex flex-col">
			<slot />
		</main>
	</body>
</html>

